{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel); if($LASTEXITCODE -ne 0 -or -not $env:LADS_PYTHON){exit 2}; Set-Location -LiteralPath $root; & $env:LADS_PYTHON -B scripts/lads_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel); if($LASTEXITCODE -ne 0 -or -not $env:LADS_PYTHON){exit 2}; Set-Location -LiteralPath $root; & $env:LADS_PYTHON -B scripts/lads_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel); if($LASTEXITCODE -ne 0 -or -not $env:LADS_PYTHON){exit 2}; Set-Location -LiteralPath $root; & $env:LADS_PYTHON -B scripts/lads_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel); if($LASTEXITCODE -ne 0 -or -not $env:LADS_PYTHON){exit 2}; Set-Location -LiteralPath $root; & $env:LADS_PYTHON -B scripts/lads_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
